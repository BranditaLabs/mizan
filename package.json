{
  "name": "mizan",
  "private": true,
  "version": "0.1.0",
  "description": "Mizan \u2014 MENA e-commerce operating system, powered by Brandita",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @mizan/shared -w @mizan/db -w @mizan/engine -w @mizan/api",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo": "npm run demo -w @mizan/engine"
  },
  "engines": {
    "node": ">=22"
  }
}
