{
  "$schema": "Mizan design tokens. Source of truth: edit this file, then run `npm run build -w @mizan/design-system`. Never edit dist/ by hand.",
  "brand": {
    "ink":      { "$value": "#0B0B0B", "$description": "Brandita ink. Display type, primary actions, the app rail." },
    "inkBar":   { "$value": "#2A2B2D", "$description": "Brandita ink bar. Hover on ink, section bars." },
    "inkMute":  { "$value": "#545454", "$description": "Brandita mute. Secondary text." },
    "paper":    { "$value": "#FEF7FF", "$description": "Brandita paper. The signature soft-lavender canvas." },
    "red":      { "$value": "#DE0000", "$description": "Brandita red. The only accent. A scalpel, not a highlighter." },
    "redHi":    { "$value": "#E33232", "$description": "Brandita red stepped for dark surfaces." },
    "line":     { "$value": "#EDEDED" },
    "line2":    { "$value": "#D9D9D9" }
  },

  "color": {
    "light": {
      "bg":             { "$value": "#FEF7FF", "$description": "App canvas (Brandita paper)" },
      "surface":        { "$value": "#FFFFFF", "$description": "Cards, tables, panels, inputs" },
      "surfaceHover":   { "$value": "#FBF4FC", "$description": "Row and item hover" },
      "surfaceSunk":    { "$value": "#F5EEF6", "$description": "Wells, table headers, segmented controls" },
      "surfaceSelected":{ "$value": "#FFF1F1", "$description": "Selected row (paired with a 2px red inline-start bar)" },
      "line":           { "$value": "#EDEDED", "$description": "Default borders and dividers" },
      "lineStrong":     { "$value": "#D9D9D9", "$description": "Input borders, emphasized dividers" },
      "text":           { "$value": "#0B0B0B", "$description": "Primary text" },
      "text2":          { "$value": "#545454", "$description": "Secondary text" },
      "text3":          { "$value": "#6B6B70", "$description": "Tertiary text, captions, placeholders" },
      "textDisabled":   { "$value": "#A6A6AB" },
      "primary":        { "$value": "#0B0B0B", "$description": "Primary action background (ink, not red)" },
      "primaryHover":   { "$value": "#2A2B2D" },
      "onPrimary":      { "$value": "#FFFFFF" },
      "brand":          { "$value": "#DE0000", "$description": "Brand accent: the red point, active indicators, one key number" },
      "brandHover":     { "$value": "#B80000" },
      "onBrand":        { "$value": "#FFFFFF" },
      "brandSoft":      { "$value": "#FDECEC" },
      "brandText":      { "$value": "#B00000", "$description": "Red text on light surfaces and on brandSoft" },
      "danger":         { "$value": "#DE0000" },
      "dangerSoft":     { "$value": "#FDECEC" },
      "dangerText":     { "$value": "#B00000" },
      "success":        { "$value": "#1BAF7A" },
      "successSoft":    { "$value": "#E4F4EC" },
      "successText":    { "$value": "#0B6E4C" },
      "warning":        { "$value": "#EDA100" },
      "warningSoft":    { "$value": "#FFF3D6" },
      "warningText":    { "$value": "#7F5300" },
      "info":           { "$value": "#2A78D6" },
      "infoSoft":       { "$value": "#E6EEFA" },
      "infoText":       { "$value": "#1C579F" },
      "neutralSoft":    { "$value": "#F1EEF2" },
      "neutralText":    { "$value": "#4A4A4F" },
      "focus":          { "$value": "#0B0B0B", "$description": "Focus ring (monochrome; red is reserved for meaning)" },
      "railBg":         { "$value": "#0B0B0B" },
      "railSurface":    { "$value": "#1A1A1C" },
      "railText":       { "$value": "#D2D2D6" },
      "railText2":      { "$value": "#8E8E94" },
      "railLine":       { "$value": "#232325" },
      "railActive":     { "$value": "#E33232" },
      "scrim":          { "$value": "rgba(11, 11, 11, 0.48)" },
      "islandEdge":     { "$value": "rgba(255, 255, 255, 0.06)", "$description": "1px inner rim of an ink island (hero, rail). On paper the island already stands out, so the rim is barely there." },
      "islandGlow":     { "$value": "rgba(11, 11, 11, 0)", "$description": "Soft glow around an ink island. None on paper." },
      "partnerTile":    { "$value": "#FFFFFF", "$description": "The light neutral tile a partner's colour logo sits on, in both themes (docs/16 §5.9)" }
    },
    "dark": {
      "bg":             { "$value": "#0B0B0B" },
      "surface":        { "$value": "#141415" },
      "surfaceHover":   { "$value": "#1B1B1D" },
      "surfaceSunk":    { "$value": "#0F0F10" },
      "surfaceSelected":{ "$value": "#241314" },
      "line":           { "$value": "#232325" },
      "lineStrong":     { "$value": "#323235" },
      "text":           { "$value": "#F7F3F8" },
      "text2":          { "$value": "#BDBAC0" },
      "text3":          { "$value": "#918E95" },
      "textDisabled":   { "$value": "#5C5A60" },
      "primary":        { "$value": "#F7F3F8", "$description": "In dark mode the primary action is paper-on-ink inverted" },
      "primaryHover":   { "$value": "#FFFFFF" },
      "onPrimary":      { "$value": "#0B0B0B" },
      "brand":          { "$value": "#EA4643", "$description": "Brandita red-hi stepped one notch so ink text on filled red passes AA; railActive keeps #E33232" },
      "brandHover":     { "$value": "#F25C58" },
      "onBrand":        { "$value": "#0B0B0B" },
      "brandSoft":      { "$value": "#2A1414" },
      "brandText":      { "$value": "#FF7A72" },
      "danger":         { "$value": "#E33232" },
      "dangerSoft":     { "$value": "#2A1414" },
      "dangerText":     { "$value": "#FF7A72" },
      "success":        { "$value": "#199E70" },
      "successSoft":    { "$value": "#0F241C" },
      "successText":    { "$value": "#4FD3A1" },
      "warning":        { "$value": "#C98500" },
      "warningSoft":    { "$value": "#2A2010" },
      "warningText":    { "$value": "#F2B84B" },
      "info":           { "$value": "#3987E5" },
      "infoSoft":       { "$value": "#121E33" },
      "infoText":       { "$value": "#7DAEF3" },
      "neutralSoft":    { "$value": "#1E1E20" },
      "neutralText":    { "$value": "#C9C6CC" },
      "focus":          { "$value": "#F7F3F8" },
      "railBg":         { "$value": "#070707" },
      "railSurface":    { "$value": "#161618" },
      "railText":       { "$value": "#D2D2D6" },
      "railText2":      { "$value": "#8E8E94" },
      "railLine":       { "$value": "#1D1D1F" },
      "railActive":     { "$value": "#E33232" },
      "scrim":          { "$value": "rgba(0, 0, 0, 0.64)" },
      "islandEdge":     { "$value": "rgba(255, 255, 255, 0.08)", "$description": "1px rim that keeps an ink island (#0B0B0B) from merging into the dark canvas (#0B0B0B): over the canvas it reads #1F1F1F (tested)." },
      "islandGlow":     { "$value": "rgba(254, 247, 255, 0.05)", "$description": "Soft paper-tinted outer glow around an ink island on the dark canvas (tested: visible, never brighter than surface hover)." },
      "partnerTile":    { "$value": "#F7F3F8", "$description": "Still a light tile on dark, so brand colours and knockouts stay true" }
    }
  },

  "viz": {
    "$description": "Categorical data colours, fixed order, never cycled, max six. Validated for colour-vision deficiency (Brandita chart system).",
    "light": ["#DE0000", "#2A78D6", "#EDA100", "#1BAF7A", "#4A3AA7", "#E87BA4"],
    "dark":  ["#F5342E", "#3987E5", "#C98500", "#199E70", "#9085E9", "#D55181"]
  },

  "font": {
    "family": {
      "sans":    { "$value": "\"Geist\", \"IBM Plex Sans Arabic\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif", "$description": "UI text. Latin from Geist, Arabic falls through to IBM Plex Sans Arabic." },
      "display": { "$value": "\"Geist\", \"Alexandria\", system-ui, sans-serif", "$description": "Headings, KPIs, marketing. Arabic in Alexandria." },
      "mono":    { "$value": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace", "$description": "Order IDs, tracking numbers, SKUs, code" },
      "arabicBody":    { "$value": "\"IBM Plex Sans Arabic\", \"Geist\", system-ui, sans-serif" },
      "arabicDisplay": { "$value": "\"Alexandria\", \"Geist\", system-ui, sans-serif" }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800, "black": 900 }
  },

  "type": {
    "$description": "size / lineHeight in px, weight, tracking in em. Arabic: tracking is always 0 and line height × 1.15 (applied by the generated CSS under :lang(ar)).",
    "displayXl": { "size": 48, "lineHeight": 52, "weight": 700, "tracking": -0.035, "family": "display" },
    "displayLg": { "size": 36, "lineHeight": 42, "weight": 700, "tracking": -0.03,  "family": "display" },
    "displayMd": { "size": 30, "lineHeight": 36, "weight": 700, "tracking": -0.025, "family": "display" },
    "headingLg": { "size": 24, "lineHeight": 32, "weight": 600, "tracking": -0.02,  "family": "display" },
    "headingMd": { "size": 20, "lineHeight": 28, "weight": 600, "tracking": -0.015, "family": "display" },
    "headingSm": { "size": 16, "lineHeight": 24, "weight": 600, "tracking": -0.01,  "family": "sans" },
    "bodyLg":    { "size": 16, "lineHeight": 24, "weight": 400, "tracking": 0,      "family": "sans" },
    "body":      { "size": 14, "lineHeight": 20, "weight": 400, "tracking": 0,      "family": "sans" },
    "bodySm":    { "size": 13, "lineHeight": 18, "weight": 400, "tracking": 0,      "family": "sans" },
    "label":     { "size": 13, "lineHeight": 16, "weight": 500, "tracking": 0,      "family": "sans" },
    "caption":   { "size": 12, "lineHeight": 16, "weight": 500, "tracking": 0.005,  "family": "sans" },
    "overline":  { "size": 11, "lineHeight": 16, "weight": 600, "tracking": 0.12,   "family": "sans", "transform": "uppercase" },
    "kpi":       { "size": 32, "lineHeight": 36, "weight": 600, "tracking": -0.03,  "family": "display", "numeric": "tabular-nums" },
    "kpiSm":     { "size": 22, "lineHeight": 28, "weight": 600, "tracking": -0.02,  "family": "display", "numeric": "tabular-nums" },
    "mono":      { "size": 13, "lineHeight": 18, "weight": 500, "tracking": 0,      "family": "mono" },
    "displayHero": { "size": 96, "lineHeight": 92, "weight": 800, "tracking": -0.045, "family": "display", "$description": "Brandita's display voice (Geist 800, -0.045em, line height .95). Landing and hero islands only." },
    "kicker":    { "size": 11, "lineHeight": 16, "weight": 700, "tracking": 0.16,   "family": "sans", "transform": "uppercase", "$description": "Brandita's kicker above a title" },
    "navLink":   { "size": 13.5, "lineHeight": 20, "weight": 600, "tracking": 0,    "family": "sans", "$description": "Top bar links" }
  },

  "space": { "0": 0, "0.5": 2, "1": 4, "1.5": 6, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80 },

  "radius": {
    "none": 0, "xs": 4, "sm": 6, "md": 8, "lg": 12, "xl": 16, "full": 9999,
    "pill": 9999, "island": 20, "islandLg": 28,
    "$description": "Controls 6, cards and panels 8, dialogs 12. Flat brand: no decorative rounding beyond this. pill: the top bar, dock and chips. island / islandLg: Brandita-style ink islands (hero, landing) only, never a data card."
  },

  "border": { "hairline": 1, "strong": 1.5, "focus": 2, "indicator": 2 },

  "shadow": {
    "$description": "Brandita is flat: no shadows on cards, buttons or shapes. The only shadow is functional depth for floating layers.",
    "none": "none",
    "overlay": "0 16px 40px -16px rgba(11, 11, 11, 0.22), 0 2px 6px -2px rgba(11, 11, 11, 0.06)",
    "island": "inset 0 0 0 1px var(--mz-island-edge), 0 24px 64px -24px var(--mz-island-glow)"
  },

  "motion": {
    "$description": "Ported from the Brandita site (web/src/styles/tokens.css, SiteHeader and MobileTabBar CSS). Durations in ms.",
    "duration": { "instant": 80, "fast": 150, "base": 200, "slow": 300, "moderate": 450, "glide": 600, "reveal": 900, "drift": 24000,
      "tip": 2600, "merge": 380, "settle": 720, "fall": 620, "ripple": 1400, "roll": 700, "route": 280, "exit": 150 },
    "$brand": "Brand 2.0 motion rules. TIP compares: two sides rise and fall, loop duration.tip at ±angle.tip. MERGE agrees: values flow into one, the neck forms in duration.merge. SETTLE arrives: easing.settle over duration.settle, small overshoot, damped wobble. DROP confirms: red enters from above once (duration.fall), then duration.ripple. roll: a figure rolling to its value. route: the route transition. exit: a toast leaving.",
    "easing": {
      "enter":  "cubic-bezier(0.23, 1, 0.32, 1)",
      "expand": "cubic-bezier(0.32, 0.72, 0, 1)",
      "exit":   "cubic-bezier(0.4, 0, 1, 1)",
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "springSoft": "cubic-bezier(0.34, 1.7, 0.64, 1)",
      "pour":   "cubic-bezier(0.22, 1, 0.36, 1)",
      "settle": "cubic-bezier(.34,1.32,.5,1)"
    },
    "easingReduced": { "$description": "Easings replaced under reduced motion (a crossfade has no overshoot).", "settle": "linear" },
    "angle": { "$description": "Degrees. tip: the TIP swing. tipHold: the tilt an off-balance badge holds.", "tip": 18, "tipHold": 8 },
    "angleReduced": { "$description": "Under reduced motion nothing swings; the held tilt stays as a still frame.", "tip": 0, "tipHold": 8 },
    "spring": {
      "$description": "Spring constants of the fluid physics (motion/physics), shared by web and Flutter. k = stiffness, c = damping, z = damping ratio; masses = the three chasing bubble masses. Under reduced motion every spring snaps to its target.",
      "pair": { "k": 110, "c": 13 },
      "level": { "k": 60, "z": 0.9, "massK": [150, 95, 60], "massC": [14, 12, 10.5] },
      "gauge": { "k": 70, "z": 0.5, "massK": [160, 100, 64], "massZ": 0.55 },
      "vessels": { "k": 55, "z": 0.42 },
      "breakeven": { "k": 60, "z": 0.45 },
      "bullseye": { "massK": [150, 95, 60], "massZ": 0.55 },
      "fill": { "smoothing": 7 }
    },
    "goo": {
      "$description": "The goo filter: blur stdDeviation per element, then an alpha matrix α' = a·A + b.",
      "loader": { "pair": 3.2, "level": 3, "transfer": 2.4, "drop": 2.4, "fill": 1.6 },
      "loaderMatrix": { "a": 36, "b": -16.5 },
      "instrument": { "gauge": 3, "vessels": 2.4, "breakeven": 2.2, "bullseye": 3 },
      "instrumentMatrix": { "a": 22, "b": -10 }
    },
    "easingAlias": { "$description": "The site's names: --mz-ease (= enter) and --mz-ease-sheet (= expand). --mz-ease-spring is the spring easing itself.", "default": "enter", "sheet": "expand" },
    "reduced": {
      "$description": "prefers-reduced-motion: every duration becomes this (transitions stay a short fade of at most 120ms; base.css cuts keyframe animations to 1ms; drift stops). Distances drop to 0, so rises become fades.",
      "instant": 0, "fast": 0, "base": 80, "slow": 120, "moderate": 120, "glide": 120, "reveal": 120, "drift": 0,
      "tip": 0, "merge": 120, "settle": 120, "fall": 0, "ripple": 0, "roll": 0, "route": 120, "exit": 80
    },
    "press": { "$description": "Press feedback scale, one value everywhere.", "scale": 0.98 },
    "distance": { "$units": { "*": "px" }, "rise": 8, "reveal": 28, "row": 14, "lean": 7 },
    "stagger":  { "$units": { "cap": "", "*": "ms" }, "$description": "Delay between list or grid items; cap is the item count after which there is no more delay.", "list": 50, "grid": 70, "cap": 8 },
    "scroll":   { "$units": { "resizeHold": "ms", "*": "px" }, "$description": "Top bar and dock: hide after scrolling down 36px, show after 6px up, hold during a resize 450ms, mini dock after 120px, solid bar after 8px.", "hideAfterDown": 36, "showAfterUp": 6, "resizeHold": 450, "miniAfter": 120, "solidAfter": 8 }
  },

  "glass": {
    "$description": "Brandita's top bar and dock glass. tintMix is the percentage of the tint mixed into the glass colour.",
    "$units": { "blurBar": "px", "blurDock": "px", "*": "" },
    "blurBar": 22, "blurDock": 18, "saturateBar": 1.6, "saturateDock": 1.9, "tintMix": 22
  },

  "fluid": {
    "$description": "Fluid values that are not plain px, emitted as --mz-<name>-fluid.",
    "gutter": "clamp(16px, 4vw, 64px)"
  },

  "size": {
    "control": { "sm": 32, "md": 36, "lg": 44 },
    "icon": { "xs": 14, "sm": 16, "md": 18, "lg": 20, "xl": 24 },
    "iconStroke": 1.75,
    "touchTarget": 44
  },

  "layout": {
    "railWidth": 232, "railCollapsed": 64, "headerHeight": 56, "contentMax": 1440, "drawerWidth": 440, "gutter": 24, "gutterMobile": 16,
    "headerHeightMobile": 52, "headerOffset": 14, "headerOffsetMobile": 10, "headerMax": 1440,
    "dockWidth": 420, "dockGap": 12, "dockHeight": 64,
    "recordDrawerWidth": 480, "peekWidth": 440,
    "pageFull": 1440, "pageWide": 1200, "pageForm": 880, "pageNarrow": 560
  },

  "breakpoint": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280, "2xl": 1536, "nav": 768, "navFull": 1280 },

  "z": { "base": 0, "sticky": 10, "rail": 20, "subnav": 29, "header": 30, "dock": 35, "dropdown": 40, "drawer": 50, "sheet": 50, "dialog": 60, "toast": 70, "tooltip": 80, "cursor": 90 }
}
