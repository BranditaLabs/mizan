{
  "name": "@mizan/db",
  "version": "0.1.0",
  "description": "Mizan PostgreSQL schema, migrations, migration runner and typed Kysely access.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mizan-db": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "codegen": "tsx --conditions=source scripts/codegen.ts",
    "migrate": "node dist/cli.js migrate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.2.17",
    "kysely": "0.29.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@types/pg": "8.23.1",
    "tsx": "^4.19.2"
  }
}
