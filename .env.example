# Standalone engine (packages/engine/src/server.ts) only.
# The API reads apps/api/.env — see apps/api/.env.example.

# Public base URL of this service (used to build the Bosta webhook URL)
PUBLIC_URL=https://engine.mizan.example
PORT=8080

# PostgreSQL (required in production; without it state is in memory only)
DATABASE_URL=postgres://mizan:password@localhost:5432/mizan

# Shopify app
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxx
SHOPIFY_CLIENT_SECRET=shpss_xxx
SHOPIFY_API_VERSION=2026-10
SHOPIFY_LOCATION_ID=gid://shopify/Location/123456789

# Bosta
BOSTA_API_KEY=xxx
# BOSTA_BASE_URL=https://app.bosta.co/api/v2
BOSTA_WEBHOOK_SECRET=generate-a-long-random-string
# BOSTA_TRACKING_URL_TEMPLATE=https://bosta.co/tracking-shipments?shipment-number={tn}

# Engine
AUTO_SHIP_TAG=mizan-confirmed
OPS_TOKEN=generate-a-long-random-string
