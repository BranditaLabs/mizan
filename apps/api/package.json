{
  "name": "@mizan/api",
  "version": "0.1.0",
  "description": "Mizan API: NestJS modular monolith (REST API and worker).",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "npm run build -w @mizan/shared",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=.env --watch dist/main.js\"",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mizan/shared": "0.1.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "^22.10.2",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.6",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "typescript": "^5.6.3",
    "unplugin-swc": "2.0.0",
    "vitest": "^2.1.8"
  }
}
