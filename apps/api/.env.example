# apps/api environment — validated at startup by src/platform/config.ts.
# Copy to .env for local development: cp .env.example .env
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
# LOG_FORMAT=pretty   # json | pretty (default: pretty in development, json elsewhere)

PUBLIC_URL=http://localhost:8080
WEB_URL=http://localhost:3000
# ADMIN_URL=http://localhost:3001
# MAX_BODY_BYTES=1048576

# Database: leave unset for an in-memory PGlite DB (migrated at boot), or
# DATABASE_URL=pglite:./.data/dev to keep data, or a real server:
# DATABASE_URL=postgres://mizan_api:password@localhost:5432/mizan
# DATABASE_URL_MIGRATOR=postgres://mizan_migrator:password@localhost:5432/mizan

# Auth: without a project id every protected route answers 401 auth_not_configured.
# FIREBASE_PROJECT_ID=mizan-staging
# Local development and end-to-end tests only (refused in production): accept the Firebase Auth
# emulator's unsigned tokens, with FIREBASE_PROJECT_ID=demo-mizan.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Owners/admins need a second factor (default: on in production only)
# AUTH_REQUIRE_MFA=false

# Secrets: Cloud KMS in staging/production; locally a dev key (openssl rand -base64 32),
# or nothing for an ephemeral key (secrets do not survive a restart).
# KMS_KEY_NAME=projects/…/locations/me-central1/keyRings/mizan/cryptoKeys/tenant-data
# SECRETS_DEV_KEY=

# Background loops (domain events, engine jobs) inside the API (default: on in development with PGlite only)
# WORKER_IN_PROCESS=true

# Integrations
# Shopify app (Partner Dashboard → app → Client credentials). App URL: $PUBLIC_URL/v1/connections/shopify/entry,
# allowed redirection URL: $PUBLIC_URL/v1/connections/shopify/callback
# SHOPIFY_API_KEY=              # client id
# SHOPIFY_API_SECRET=           # client secret (OAuth and webhook HMAC)
# SHOPIFY_SCOPES=read_orders,read_products,…   # default: docs/06 §3
# BOSTA_BASE_URL=https://app.bosta.co/api/v2
# BOSTA_TRACKING_URL_TEMPLATE=https://bosta.co/tracking-shipments?shipment-number={tn}

SHOPIFY_API_VERSION=2026-10
# Observability: /metrics answers 404 unless a token is set (openssl rand -hex 24)
# METRICS_TOKEN=
# SENTRY_DSN=
