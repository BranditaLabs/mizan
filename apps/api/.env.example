# apps/api environment — validated at startup by src/platform/config.ts.
# Copy to .env for local development: cp .env.example .env
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

PUBLIC_URL=http://localhost:8080
WEB_URL=http://localhost:3000

# Database (required in production; E1-4)
# DATABASE_URL=postgres://mizan_app:password@localhost:5432/mizan
# DATABASE_URL_MIGRATOR=postgres://mizan_migrator:password@localhost:5432/mizan

# Auth (E1-5)
# FIREBASE_PROJECT_ID=mizan-staging

# Secrets service (E1-10)
# KMS_KEY_NAME=projects/…/locations/me-central1/keyRings/mizan/cryptoKeys/tenant-data

SHOPIFY_API_VERSION=2026-10
# SENTRY_DSN=
