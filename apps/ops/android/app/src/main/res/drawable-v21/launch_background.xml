<?xml version="1.0" encoding="utf-8"?>
<!-- Brand 2.0 splash (D3): paper by day, ink at night (values-night), the mark centred.
     splash_mark.png comes from packages/design-system/scripts/build-png.mjs. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/mizan_splash" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
