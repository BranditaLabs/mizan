# apps/admin — read at build time (NEXT_PUBLIC_* are baked into the browser bundle; none of them is a secret).
# Copy to .env.local for development: cp .env.example .env.local
# The API must allow this app's origin: ADMIN_URL=http://localhost:3001 in apps/api/.env (on Azure, Terraform
# sets ADMIN_URL from admin_domain once bound, else the ca-mizan-admin FQDN). Deployed by CI with
# apps/admin/Dockerfile, built with the GitHub variables API_URL and FIREBASE_* (docs/09).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Firebase web app config, the same project as the dashboard (Firebase console → Project settings → Your apps).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mizan-staging.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=mizan-staging

# Local development without a Firebase project: the Auth emulator (see apps/web/.env.example).
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
