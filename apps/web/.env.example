# apps/web — read at build time (NEXT_PUBLIC_* are baked into the browser bundle; none of them is a secret).
# Copy to .env.local for development: cp .env.example .env.local
NEXT_PUBLIC_API_URL=http://localhost:8080

# Firebase web app config (Firebase console → Project settings → Your apps). Without it the sign-in
# page says sign-in is not configured.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mizan-staging.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=mizan-staging

# Local development without a Firebase project: the Auth emulator
#   cd apps/web/e2e && npx -y firebase-tools@15.34.0 emulators:start --only auth --project demo-mizan --config "$PWD/firebase.json"
# and run the API with FIREBASE_PROJECT_ID=demo-mizan FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099.
# SMS codes and email links: http://127.0.0.1:9099/emulator/v1/projects/demo-mizan/verificationCodes (and /oobCodes).
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-mizan
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-mizan.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
