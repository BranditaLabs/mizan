{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.3.0"],
      "env": { "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}" }
    },
    "21st-magic": {
      "command": "npx",
      "args": ["-y", "@21st-dev/magic@0.2.3"],
      "env": { "API_KEY_21ST": "${API_KEY_21ST:-}" }
    }
  }
}
